# BEA Training Engine — Phase 0 Spike
# Copy to .env and fill in real values. .env is gitignored.

# ----- Anthropic (orchestration / review pass) -----
# Used by spike_orchestrator.py to coordinate steps and review generated scripts
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- NotebookLM -----
# notebooklm-py uses one of: browser cookies, OAuth, or session token.
# READ forks/notebooklm-py/README.md before filling these in — the exact vars
# depend on the fork's auth method. Common patterns:

# Option A: session cookie (if notebooklm-py reads NOTEBOOKLM_COOKIE)
# NOTEBOOKLM_COOKIE=

# Option B: OAuth refresh token (if it uses Google OAuth)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Option C: cookies.txt file path (if it uses a yt-dlp-style cookies file)
# NOTEBOOKLM_COOKIES_FILE=./secrets/cookies.txt

# Replace the above with whatever the fork's README specifies.

# ----- Spike topic -----
# Default per runbook. Change if you want to try a different topic.
SPIKE_TOPIC="How to acknowledge a gifter on TikTok LIVE"

# ----- Brand -----
# Path to the brand theme JSON (in this repo, but overridable for testing variants)
BRAND_THEME_PATH=./brand/theme.json

# ----- Outputs -----
OUTPUT_DIR=./outputs
