# BEA Training Engine — Phase 0 Spike
# Copy to .env and fill in real values. .env is gitignored.

# ----- NotebookLM Enterprise (official Google Cloud API) -----
# Auth is via `gcloud auth print-access-token` — run `gcloud auth login` first.
# Prereqs: NotebookLM Enterprise license enabled on your GCP project.
# Docs: https://docs.cloud.google.com/gemini/enterprise/notebooklm-enterprise/docs/api-notebooks

GCP_PROJECT_NUMBER=
# Cloud Translation needs the project ID (not just the number).
# Get it from `gcloud config get-value project`.
GCP_PROJECT_ID=
NOTEBOOKLM_LOCATION=us              # one of: us | eu | global

# ----- Anthropic (slide derivation + orchestration review) -----
# Used by spike_orchestrator.py to derive a slide outline from the audio
# overview transcript (or directly from sources if NotebookLM falls through).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----- Spike topic -----
# Default per runbook. Change if you want to try a different topic.
SPIKE_TOPIC="How to acknowledge a gifter on TikTok LIVE"

# ----- YouTube Data API + Analytics (channel: @boldevolution) -----
# Step 1: in Google Cloud Console, enable "YouTube Data API v3" and
#         "YouTube Analytics API" on the BEA GCP project.
# Step 2: create an OAuth 2.0 Client ID (Desktop application). Download the
#         client secret JSON and save it as secrets/youtube-client-secret.json.
# Step 3: run `python src/youtube_auth.py` once as a channel admin. It opens a
#         browser, you consent, and the refresh token is saved to
#         secrets/youtube-token.json. After that, all uploads / analytics
#         requests reuse the saved token (no further prompts).
YOUTUBE_CLIENT_SECRET=./secrets/youtube-client-secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube-token.json

# Default video privacy. Locked to unlisted per BEA policy.
YOUTUBE_DEFAULT_PRIVACY=unlisted

# Default category for training videos.
# 27 = Education. Full list: https://gist.github.com/dgp/1b24bf2961521bd75d6c
YOUTUBE_DEFAULT_CATEGORY=27

# ----- Training playlists (the Toklytics handoff) -----
# Toklytics-LiveIQ reads training modules from these playlists. Adding a
# video to the right playlist is what makes it appear in the creator app.
# Find playlist IDs with: python src/spike_orchestrator.py list-playlists
# Per-language fallback used when the orchestrator's --playlist flag and
# module.playlist_id are not set.
YOUTUBE_PLAYLIST_TRAINING_EN_US=
YOUTUBE_PLAYLIST_TRAINING_ES_US=

# ----- Thumbnail engine -----
# pil       = local PIL render (default; no external service; deterministic)
# trpc-text = YouTube-Thumbnail web service, text_prompt mode (pre-upload)
# trpc-url  = YouTube-Thumbnail web service, video_url mode (post-upload,
#             tool analyzes the actual published video)
# skip      = no thumbnail (YouTube uses an auto-frame)
# Override per-call with `publish-youtube --thumbnail-mode <mode>`.
THUMBNAIL_ENGINE=pil
YOUTUBE_THUMBNAIL_SERVICE_URL=http://localhost:4000
YOUTUBE_THUMBNAIL_API_KEY=

# ----- TTS engine for narration -----
# kokoro = local, free (Phase 0 / development only — does not meet Phase 0.5
#          voice quality bar per quality strategy doc)
# gcloud = Google Cloud TTS Studio voices (recommended for Phase 0.5+).
#          ~$0.02 per 90-sec video. Same GCP project as NotebookLM Enterprise,
#          so no new vendor relationship.
#          Suggested flagship voices:
#            English: en-US-Studio-Q (male, conversational) or en-US-Studio-O
#                     (female, natural). Pick one and use it across all modules
#                     so it becomes "the BEA voice" by repetition.
#            Spanish: es-US-Studio-B
TTS_ENGINE=gcloud

# ----- Brand -----
BRAND_THEME_PATH=./brand/theme.json

# ----- Outputs -----
OUTPUT_DIR=./outputs

# ----- Optional fallback (only if NotebookLM Enterprise isn't licensed yet) -----
# The unofficial notebooklm-py fork can be used Day 1 to sanity-test if you
# don't have Enterprise access. Set USE_LEGACY_NOTEBOOKLM=true and provide:
# USE_LEGACY_NOTEBOOKLM=false
# NOTEBOOKLM_COOKIE=
